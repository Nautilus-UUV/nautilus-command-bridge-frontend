# Runtime artifacts -- the DuckDB store, rolling parquet, and the venv. The
# code is tracked; the recorded data is not.
data/
.venv/
__pycache__/
*.pyc

# Cloud-mirror secrets -- never commit OAuth client secrets or user tokens
# (the default token lives under data/, already ignored; these cover copies
# kept elsewhere in the folder).
*token*.json
client_secret*.json
credentials*.json
